    as (
      -- Order items fact table
-- This model provides order item-level facts for detailed analytics



with order_items_enhanced as (
    select * from "ecommerce_analytics"."main"."int_order_items_enhanced"
),

final as (
    select
        order_item_id,
        order_id,
        product_id,
        customer_id,
        order_date,
        quantity,
        unit_price_cents,
        unit_price_dollars,
        line_total_cents,
        line_total_dollars,
        
        -- Product attributes
        product_name,
        category,
        category_clean,
        product_list_price_cents,
        product_list_price_dollars,
        price_tier,
        
        -- Order attributes
