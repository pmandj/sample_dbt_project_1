        c.lifetime_revenue as simple_ltv,  -- Different naming
        c.lifetime_revenue - coalesce(r.total_returned, 0) as net_ltv,  -- Different naming
        case when c.total_orders > 0 then c.lifetime_revenue / c.total_orders else 0 end as ltv_per_order,
        
        -- Customer tenure
        current_date - c.first_order_date as customer_age_days,
        c.last_order_date - c.first_order_date as active_period_days,
        
        -- Customer health score
        case 
            when c.total_orders >= 10 and c.lifetime_revenue >= 1000 and coalesce(r.return_incidents, 0) <= 2 then 5
            when c.total_orders >= 5 and c.lifetime_revenue >= 500 and coalesce(r.return_incidents, 0) <= 3 then 4
            when c.total_orders >= 3 and c.lifetime_revenue >= 200 then 3
            when c.total_orders >= 1 and c.lifetime_revenue >= 50 then 2
            else 1
        end as health_score
    from "ecommerce_analytics"."main"."dim_customers" c
    left join "ecommerce_analytics"."main"."int_customer_marketing" m on c.customer_id = m.customer_id
    left join customer_payments p on c.customer_id = p.customer_id
    left join customer_returns r on c.customer_id = r.customer_id
)

select * from final
    );
  
  
