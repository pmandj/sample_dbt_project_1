  create view "ecommerce_analytics"."main"."stg_suppliers__dbt_tmp" as (
    

with source_data as (
    select
        supplier_id,
        supplier_name as name,  -- Inconsistent naming
        contact_email as email,  -- Different field name than customers
        phone_number,
        address,
        city,
        state,
        country,
        rating,
        contract_start_date::date as contract_start
    from "ecommerce_analytics"."main"."raw_suppliers"
),

enhanced as (
    select
        *,
        concat(city, ', ', state, ' ', country) as full_address,
        case 
            when rating >= 4.5 then 'excellent'
            when rating >= 4.0 then 'good'
            when rating >= 3.5 then 'average'
            else 'poor'
        end as rating_category,
        current_date - contract_start as contract_days
    from source_data
)

select * from enhanced
  );

[0m00:39:17.456775 [debug] [Thread-2 (]: Opening a new connection, currently in state closed
